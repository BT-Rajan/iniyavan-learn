# Copy to .env and fill in. Only SECRET_KEY is required.
SECRET_KEY=change-me-to-a-long-random-string
# APP_NAME="Eng Tutor"                     # shown until an admin renames it in Settings
# HOST=127.0.0.1                           # where run.sh starts the app (behind nginx), and PORT
# PORT=5252
# APP_URL=https://learn.example.org        # used in emails (password reset links)
# DATABASE_URL=sqlite:///data/app.db        # or mysql+pymysql://user:pass@localhost/dbname?charset=utf8mb4, postgresql+psycopg://...
# SECURE_COOKIES=1                          # set when served over HTTPS
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM= SMTP_TLS=starttls   # (or ssl on 465) enables password reset and sign-up
# AI_API_KEY=                               # institution AI key (can also be set in Admin → Settings)
# AI_BASE_URL=https://api.deepseek.com      # any OpenAI-compatible API
# AI_MODEL=deepseek-chat
